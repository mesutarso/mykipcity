# Modèle sans secrets pour le pilote distant à données fictives.
# Copier dans la configuration privée du serveur, jamais dans le dépôt.
NODE_ENV=production
BETTER_AUTH_URL=https://my.kip-city.com
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DEMO_MODE=true
REQUIRE_STAFF_MFA=true

# Adapter au volume local persistant du serveur choisi.
DATABASE_URL=file:/srv/mykipcity/data/database.sqlite
DOCUMENTS_DIR=/srv/mykipcity/data/documents

# Activer après configuration privée et vérification sur le serveur.
MAIL_FROM=my@kip-city.com
RESEND_API_KEY=
MAIL_ENABLED=false
MAIL_AUTORUN=false
