{
  "name": "kipcity-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3200",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3200",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --import tsx scripts/seed.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:seed:finance": "node --import tsx scripts/seed-finance.ts",
    "db:seed:admin": "node --import tsx scripts/seed-admin.ts",
    "db:seed:controls": "node --import tsx scripts/seed-controls.ts",
    "db:seed:publications": "node --import tsx scripts/seed-publications.ts",
    "backup": "node --import tsx scripts/backup.ts",
    "mail": "node --import tsx scripts/mail.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.6",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dotenv": "18.0.4",
    "eslint-plugin-react": "7.37.5",
    "lucide-react": "1.48.0",
    "next": "16.3.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.1",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
