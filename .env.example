DATABASE_URL=file:./data/development.db
BETTER_AUTH_URL=http://127.0.0.1:3200
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DEMO_MODE=true
DOCUMENTS_DIR=./data/documents


# Accès internes : double authentification requise (false uniquement pour recette isolée)
REQUIRE_STAFF_MFA=true
# Courriels : désactivés tant que le domaine et l’expéditeur ne sont pas configurés
MAIL_ENABLED=false
MAIL_AUTORUN=false
MAIL_FROM=
RESEND_API_KEY=
